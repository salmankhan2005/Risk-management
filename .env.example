# Database Connection String (Direct PostgreSQL URI for Python Worker & Migrations)
CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase REST API & Realtime (Web Application)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...[YOUR-ANON-KEY]

# Clerk Authentication (Optional for demo mode; required for persistent multi-tenant accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_[YOUR-CLERK-KEY]
CLERK_SECRET_KEY=sk_test_[YOUR-CLERK-SECRET]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/overview
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/app/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/app/overview
